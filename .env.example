# Telegram Bot Configuration
# Get your token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Provider: 'gemini' (Recommended - 1500 calls/day free), 'groq' (Free fast), or 'ollama' (Local)
AI_PROVIDER=gemini

# Free Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Free Groq API Key (Optional, get from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Local Ollama Settings (Optional, if running local LLM)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=openai:qwen2.5:7b
